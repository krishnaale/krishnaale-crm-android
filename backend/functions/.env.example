# Copy to ".env" inside the functions/ folder. Do NOT commit the real .env.

# Shared secret to authenticate incoming AgencyHandy webhooks.
# Set the SAME value on the AgencyHandy webhook (as the x-webhook-secret header,
# or append ?secret=YOUR_SECRET to the endpoint URL you register).
# Leave blank during first testing to accept any request, then set it for production.
WEBHOOK_SECRET=

# Your client portal URL (used for notification deep links).
PORTAL_URL=https://krishnaale.agencyhandy.com/

# Set to "true" once, capture a real webhook in the logs to confirm the payload
# shape, then set back to "false".
DEBUG_LOG_PAYLOAD=false
